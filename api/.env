# Environment configuration for Spendy API
NODE_ENV=development
PORT=8765

# Firebase
FIREBASE_PROJECT_ID=spendy-97913

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-spendy-api-2024
JWT_EXPIRES_IN=7d

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=spendy-97913

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
