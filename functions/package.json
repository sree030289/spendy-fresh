{
  "name": "functions",
  "description": "Spendy Deals Cloud Functions",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --force",
    "logs": "firebase functions:log",
    "lint": "exit 0",
    "lint:fix": "eslint . --fix",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "expo": "~53.0.22",
    "express": "^5.1.0",
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^6.4.0",
    "libphonenumber-js": "^1.12.22",
    "nodemailer": "^6.9.8",
    "react": "19.0.0",
    "react-native": "0.79.6"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true,
  "version": "1.0.0"
}
