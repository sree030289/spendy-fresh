// ===== GMAIL INTEGRATION ROUTES =====

// Gmail OAuth auth URL
meetnsplitApp.get('/gmail/auth-url', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    
    // Use Google OAuth credentials from environment variables
    const clientId = process.env.GOOGLE_CLIENT_ID;
    const redirectUri = encodeURIComponent('https://us-central1-spendy-develop.cloudfunctions.net/spendyApi/gmail/callback');
    const scope = encodeURIComponent('https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email');
    
    const authUrl = `https://accounts.google.com/o/oauth2/v2/auth?client_id=${clientId}&redirect_uri=${redirectUri}&scope=${scope}&response_type=code&access_type=offline&prompt=consent&state=${userId}`;
    
    console.log(`🔗 Generated Gmail auth URL for user: ${userId}`);
    
    res.json({
      success: true,
      data: { authUrl },
      message: 'Gmail authorization URL generated successfully'
    });
    
  } catch (error) {
    console.error('Generate Gmail auth URL error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to generate Gmail authorization URL',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Gmail connection status
meetnsplitApp.get('/gmail/status', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    
    // Check if user has Gmail connected
    const gmailConnectionDoc = await db.collection('gmailConnections').doc(userId).get();
    
    if (gmailConnectionDoc.exists) {
      const connection = gmailConnectionDoc.data();
      res.json({
        success: true,
        data: {
          isConnected: connection.isConnected || false,
          email: connection.email || '',
          lastSyncAt: connection.lastSyncAt,
          autoSync: connection.autoSync || false,
          syncFrequency: connection.syncFrequency || 'daily'
        }
      });
    } else {
      res.json({
        success: true,
        data: {
          isConnected: false
        }
      });
    }
    
  } catch (error) {
    console.error('Get Gmail status error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get Gmail status',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Gmail connect (OAuth token exchange)
meetnsplitApp.post('/gmail/connect', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    const { code } = req.body;
    
    if (!code) {
      return res.status(400).json({
        success: false,
        message: 'Authorization code is required'
      });
    }
    
    // Exchange authorization code for access token
    const tokenResponse = await fetch('https://oauth2.googleapis.com/token', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams({
        client_id: process.env.GOOGLE_CLIENT_ID,
        client_secret: process.env.GOOGLE_CLIENT_SECRET,
        code: code,
        grant_type: 'authorization_code',
        redirect_uri: 'https://us-central1-spendy-develop.cloudfunctions.net/spendyApi/gmail/callback'
      })
    });
    
    if (!tokenResponse.ok) {
      throw new Error(`Token exchange failed: ${tokenResponse.statusText}`);
    }
    
    const tokens = await tokenResponse.json();
    
    // Get user info from Google
    const userInfoResponse = await fetch('https://www.googleapis.com/oauth2/v2/userinfo', {
      headers: {
        'Authorization': `Bearer ${tokens.access_token}`
      }
    });
    
    if (!userInfoResponse.ok) {
      throw new Error(`Failed to get user info: ${userInfoResponse.statusText}`);
    }
    
    const userInfo = await userInfoResponse.json();
    
    // Calculate token expiry
    const expiresAt = new Date(Date.now() + (tokens.expires_in * 1000));
    
    const connectionData = {
      userId,
      email: userInfo.email,
      accessToken: tokens.access_token,
      refreshToken: tokens.refresh_token || null,
      expiresAt: expiresAt,
      isConnected: true,
      autoSync: true,
      syncFrequency: 'daily',
      connectedAt: FieldValue.serverTimestamp(),
      updatedAt: FieldValue.serverTimestamp()
    };
    
    await db.collection('gmailConnections').doc(userId).set(connectionData);
    
    console.log(`✅ Gmail connected successfully for user ${userId}: ${userInfo.email}`);
    
    res.json({
      success: true,
      data: {
        email: userInfo.email,
        isConnected: true,
        autoSync: true,
        syncFrequency: 'daily'
      },
      message: 'Gmail connected successfully'
    });
    
  } catch (error) {
    console.error('Connect Gmail error:', error);
    res.status(500).json({
      success: false,
      message: error instanceof Error ? error.message : 'Failed to connect Gmail',
      error: 'GMAIL_CONNECTION_FAILED'
    });
  }
});

// Gmail sync bills
meetnsplitApp.post('/gmail/sync', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    
    // Check if Gmail is connected
    const gmailConnectionDoc = await db.collection('gmailConnections').doc(userId).get();
    
    if (!gmailConnectionDoc.exists || !gmailConnectionDoc.data().isConnected) {
      return res.status(400).json({
        success: false,
        message: 'Gmail not connected. Please connect first.',
        error: 'GMAIL_NOT_CONNECTED'
      });
    }
    
    // Get Gmail access token from connection
    const connectionData = gmailConnectionDoc.data();
    const accessToken = connectionData.accessToken;
    
    if (!accessToken) {
      return res.status(400).json({
        success: false,
        message: 'Gmail access token not found. Please reconnect Gmail.',
        error: 'NO_ACCESS_TOKEN'
      });
    }
    
    // Scan Gmail for bills using real Gmail API
    const bills = await scanGmailForBills(accessToken);
    
    console.log(`📧 Gmail scan found ${bills.length} potential bills`);
    
    // Log the bills that were found for debugging
    bills.forEach((bill, index) => {
      console.log(`📋 Bill ${index + 1}: ${bill.title} - $${bill.amount} - Due: ${bill.dueDate.toDateString()} - From: ${bill.emailSource} - Confidence: ${Math.round(bill.confidence * 100)}%`);
    });
    
    async function scanGmailForBills(accessToken) {
      try {
        // Search for emails with bill/invoice keywords (more specific to avoid donations/promotions)
        const searchQuery = 'subject:(bill OR invoice OR payment OR subscription OR due OR statement OR receipt OR "monthly bill" OR "electricity" OR "gas bill" OR "phone bill" OR "internet bill" OR "credit card") OR from:(billing OR invoice OR utilities OR "electric company" OR "gas company" OR telstra OR optus OR "credit card")';
        
        // Get list of message IDs
        const messagesResponse = await fetch(
          `https://gmail.googleapis.com/gmail/v1/users/me/messages?q=${encodeURIComponent(searchQuery)}&maxResults=50`,
          {
            headers: {
              'Authorization': `Bearer ${accessToken}`,
              'Content-Type': 'application/json'
            }
          }
        );
        
        if (!messagesResponse.ok) {
          console.error('Failed to search Gmail messages:', messagesResponse.statusText);
          return [];
        }
        
        const messagesData = await messagesResponse.json();
        const messageIds = messagesData.messages || [];
        
        console.log(`📧 Found ${messageIds.length} potential bill emails`);
        
        const detectedBills = [];
        
        // Process first 10 emails to avoid rate limits
        for (let i = 0; i < Math.min(messageIds.length, 10); i++) {
          const messageId = messageIds[i].id;
          
          try {
            // Get full message details
            const messageResponse = await fetch(
              `https://gmail.googleapis.com/gmail/v1/users/me/messages/${messageId}`,
              {
                headers: {
                  'Authorization': `Bearer ${accessToken}`,
                  'Content-Type': 'application/json'
                }
              }
            );
            
            if (!messageResponse.ok) {
              console.log(`Failed to fetch message ${messageId}`);
              continue;
            }
            
            const messageData = await messageResponse.json();
            
            // Extract bill information from email
            const bill = extractBillFromEmail(messageData);
            if (bill) {
              detectedBills.push(bill);
            }
            
            // Small delay to respect rate limits
            await new Promise(resolve => setTimeout(resolve, 100));
            
          } catch (error) {
            console.error(`Error processing message ${messageId}:`, error);
          }
        }
        
        return detectedBills;
        
      } catch (error) {
        console.error('Error scanning Gmail:', error);
        return [];
      }
    }
    
    function extractBillFromEmail(messageData) {
      try {
        const headers = messageData.payload&&headers || [];
        const subject = headers.find(h => h.name.toLowerCase() === 'subject')&&value || '';
        const from = headers.find(h => h.name.toLowerCase() === 'from')&&value || '';
        const date = headers.find(h => h.name.toLowerCase() === 'date')&&value || '';
        
        // Get email body
        let body = '';
        if (messageData.payload&&parts) {
          // Multi-part message
          for (const part of messageData.payload.parts) {
            if (part.mimeType === 'text/plain' && part.body&&data) {
              body += Buffer.from(part.body.data, 'base64').toString('utf-8');
            }
          }
        } else if (messageData.payload&&body&&data) {
          // Simple message
          body = Buffer.from(messageData.payload.body.data, 'base64').toString('utf-8');
        }
        
        // Extract amount using regex patterns
        const amountPatterns = [
          /\$(\d+(?:,\d{3})*(?:\.\d{2})?)/g,
          /(\d+(?:,\d{3})*(?:\.\d{2})?)\s*USD/g,
          /Amount:?\s*\$?(\d+(?:,\d{3})*(?:\.\d{2})?)/gi,
          /Total:?\s*\$?(\d+(?:,\d{3})*(?:\.\d{2})?)/gi,
          /Due:?\s*\$?(\d+(?:,\d{3})*(?:\.\d{2})?)/gi
        ];
        
        let amount = null;
        for (const pattern of amountPatterns) {
          const matches = body.match(pattern);
          if (matches) {
            // Get the first reasonable amount (between $1 and $10000)
            for (const match of matches) {
              const numStr = match.replace(/[^0-9.]/g, '');
              const num = parseFloat(numStr);
              if (num >= 1 && num <= 10000) {
                amount = num;
                break;
              }
            }
            if (amount) break;
          }
        }
        
        // Skip if no amount found
        if (!amount) return null;
        
        // Filter out donation requests, promotional emails, and non-bills
        const subjectLower = subject.toLowerCase();
        const fromLower = from.toLowerCase();
        const bodyLower = body.toLowerCase();
        
        // Skip donation requests
        if (subjectLower.includes('donation') || subjectLower.includes('donate') || 
            subjectLower.includes('help us') || subjectLower.includes('support') ||
            fromLower.includes('charity') || fromLower.includes('foundation') ||
            bodyLower.includes('donation') || bodyLower.includes('donate')) {
          console.log(`⏭️  Skipping donation/charity email: ${subject}`);
          return null;
        }
        
        // Skip promotional/marketing emails
        if (subjectLower.includes('promotion') || subjectLower.includes('discount') ||
            subjectLower.includes('sale') || subjectLower.includes('offer') ||
            subjectLower.includes('deal') || subjectLower.includes('free') ||
            bodyLower.includes('unsubscribe') || bodyLower.includes('promotional')) {
          console.log(`⏭️  Skipping promotional email: ${subject}`);
          return null;
        }
        
        // Skip money transfer confirmations (these aren't bills to pay)
        if (subjectLower.includes('transfer sent') || subjectLower.includes('money sent') ||
            subjectLower.includes('payment sent') || fromLower.includes('wise') ||
            fromLower.includes('paypal') || fromLower.includes('bank transfer')) {
          console.log(`⏭️  Skipping transfer confirmation: ${subject}`);
          return null;
        }
        
        // Extract due date
        const dueDatePatterns = [
          /due\s+(?:date|on|by):\s*(\w+\s+\d{1,2},?\s+\d{4})/gi,
          /payment\s+due:\s*(\w+\s+\d{1,2},?\s+\d{4})/gi,
          /due\s+by\s+(\w+\s+\d{1,2},?\s+\d{4})/gi
        ];
        
        let dueDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000); // Default 30 days
        for (const pattern of dueDatePatterns) {
          const match = body.match(pattern);
          if (match) {
            const parsedDate = new Date(match[1]);
            if (!isNaN(parsedDate.getTime())) {
              dueDate = parsedDate;
              break;
            }
          }
        }
        
        // Categorize based on sender and subject
        let category = 'other';
        
        if (fromLower.includes('netflix') || subjectLower.includes('netflix')) category = 'subscription';
        else if (fromLower.includes('spotify') || subjectLower.includes('spotify')) category = 'subscription';
        else if (fromLower.includes('electric') || subjectLower.includes('electric')) category = 'utilities';
        else if (fromLower.includes('gas') || subjectLower.includes('gas')) category = 'utilities';
        else if (fromLower.includes('water') || subjectLower.includes('water')) category = 'utilities';
        else if (fromLower.includes('internet') || subjectLower.includes('internet')) category = 'utilities';
        else if (fromLower.includes('phone') || subjectLower.includes('phone')) category = 'utilities';
        else if (fromLower.includes('credit') || subjectLower.includes('credit')) category = 'credit_card';
        else if (fromLower.includes('bank') || subjectLower.includes('statement')) category = 'banking';
        else if (fromLower.includes('insurance') || subjectLower.includes('insurance')) category = 'insurance';
        else if (subjectLower.includes('subscription')) category = 'subscription';
        else if (subjectLower.includes('bill') || subjectLower.includes('invoice')) category = 'bills';
        
        // Extract company name for title
        let title = subject.replace(/^(re:|fwd?:)\s*/gi, '').trim();
        if (title.length > 50) {
          title = title.substring(0, 50) + '...';
        }
        
        // Calculate confidence score
        let confidence = 0.5;
        if (amount > 0) confidence += 0.3;
        if (subjectLower.includes('bill') || subjectLower.includes('invoice')) confidence += 0.2;
        if (fromLower.includes('billing') || fromLower.includes('noreply')) confidence += 0.1;
        if (category !== 'other') confidence += 0.1;
        
        return {
          title: title || `Bill from ${from.split('@')[0]}`,
          amount: amount,
          currency: 'USD',
          category: category,
          dueDate: dueDate,
          emailSource: from,
          confidence: Math.min(confidence, 0.95),
          messageId: messageData.id,
          receivedDate: new Date(parseInt(messageData.internalDate))
        };
        
      } catch (error) {
        console.error('Error extracting bill from email:', error);
        return null;
      }
    }
    
    // Create reminders from bills
    let createdCount = 0;
    const createdReminders = [];
    
    for (const bill of bills) {
      console.log(`🔍 Checking for existing reminder: ${bill.title} - $${bill.amount}`);
      
      // Check for duplicates
      const existingQuery = await db.collection('reminders')
        .where('userId', '==', userId)
        .where('title', '==', bill.title)
        .where('amount', '==', bill.amount)
        .get();
      
      if (existingQuery.empty) {
        console.log(`✅ No duplicate found, creating reminder for: ${bill.title}`);
      } else {
        console.log(`⚠️  Duplicate found, skipping: ${bill.title} - Found ${existingQuery.size} existing reminder(s)`);
      }
      
      if (existingQuery.empty) {
        const reminderData = {
          userId,
          title: bill.title,
          description: `Auto-detected from ${bill.emailSource}`,
          amount: bill.amount,
          currency: bill.currency,
          category: bill.category,
          dueDate: bill.dueDate,
          status: 'upcoming',
          isRecurring: false,
          reminderDays: [1, 3],
          notificationEnabled: true,
          autoDetected: true,
          emailSource: bill.emailSource,
          notes: `Gmail sync - Confidence: ${Math.round(bill.confidence * 100)}%`,
          createdAt: FieldValue.serverTimestamp(),
          updatedAt: FieldValue.serverTimestamp()
        };
        
        const docRef = await db.collection('reminders').add(reminderData);
        createdReminders.push({ id: docRef.id, ...bill });
        createdCount++;
        
        // Schedule notifications
        console.log(`📅 Scheduling notifications for new reminder: ${bill.title}`);
      }
    }
    
    // Update last sync time
    await db.collection('gmailConnections').doc(userId).update({
      lastSyncAt: FieldValue.serverTimestamp(),
      updatedAt: FieldValue.serverTimestamp()
    });
    
    res.json({
      success: true,
      data: {
        billsFound: bills.length,
        remindersCreated: createdCount,
        duplicatesSkipped: bills.length - createdCount,
        failures: 0,
        bills: createdReminders
      },
      message: `Gmail sync completed. Created ${createdCount} reminders from ${bills.length} bills found.`
    });
    
  } catch (error) {
    console.error('Sync Gmail bills error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to sync Gmail bills',
      error: 'GMAIL_SYNC_FAILED'
    });
  }
});

