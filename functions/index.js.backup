// Get user reminders
meetnsplitApp.get('/reminders', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    
    // Get query parameters
    const {
      status,
      category,
      startDate,
      endDate,
      page = 1,
      limit = 50,
      search
    } = req.query;
    
    console.log(`📋 Getting reminders for user: ${userId}`);
    
    // Build query
    let query = db.collection('reminders').where('userId', '==', userId);
    
    // Add filters
    if (status && status !== 'all') {
      query = query.where('status', '==', status);
    }
    
    if (category) {
      query = query.where('category', '==', category);
    }
    
    // Order by due date
    query = query.orderBy('dueDate', 'asc');
    
    // Execute query
    const snapshot = await query.get();
    
    let reminders = [];
    snapshot.forEach(doc => {
      const data = doc.data();
      reminders.push({
        id: doc.id,
        ...data,
        dueDate: data.dueDate&&toDate ? data.dueDate.toDate() : data.dueDate,
        createdAt: data.createdAt&&toDate ? data.createdAt.toDate() : data.createdAt,
        updatedAt: data.updatedAt&&toDate ? data.updatedAt.toDate() : data.updatedAt,
        paidDate: data.paidDate&&toDate ? data.paidDate.toDate() : data.paidDate
      });
    });
    
    // Apply text search filter
    if (search) {
      const searchLower = search.toLowerCase();
      reminders = reminders.filter(reminder => 
        reminder.title&&toLowerCase().includes(searchLower) ||
        reminder.description&&toLowerCase().includes(searchLower) ||
        reminder.category&&toLowerCase().includes(searchLower)
      );
    }
    
    // Apply date filters
    if (startDate) {
      const start = new Date(startDate);
      reminders = reminders.filter(reminder => new Date(reminder.dueDate) >= start);
    }
    
    if (endDate) {
      const end = new Date(endDate);
      reminders = reminders.filter(reminder => new Date(reminder.dueDate) <= end);
    }
    
    // Apply pagination
    const totalReminders = reminders.length;
    const offset = (parseInt(page) - 1) * parseInt(limit);
    const paginatedReminders = reminders.slice(offset, offset + parseInt(limit));
    
    console.log(`📋 Found ${totalReminders} reminders for user: ${userId}`);
    
    res.json({
      success: true,
      data: {
        data: paginatedReminders,
        pagination: {
          page: parseInt(page),
          limit: parseInt(limit),
          total: totalReminders,
          totalPages: Math.ceil(totalReminders / parseInt(limit))
        }
      }
    });
    
  } catch (error) {
    console.error('Get reminders error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get reminders',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Create reminder
meetnsplitApp.post('/reminders', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    const {
      title,
      description = '',
      amount,
      category,
      dueDate,
      isRecurring = false,
      recurringType,
      reminderDays = [1],
      notificationEnabled = true,
      notes = ''
    } = req.body;
    
    // Validation
    if (!title || !amount || !category || !dueDate) {
      return res.status(400).json({
        success: false,
        message: 'Missing required fields: title, amount, category, dueDate',
        error: 'VALIDATION_ERROR'
      });
    }
    
    console.log(`📝 Creating reminder for user: ${userId}`);
    
    const reminderData = {
      userId,
      title: title.trim(),
      description: description.trim(),
      amount: parseFloat(amount),
      category,
      dueDate: admin.firestore.Timestamp.fromDate(new Date(dueDate)),
      status: 'upcoming',
      isRecurring,
      recurringType: isRecurring ? recurringType : null,
      reminderDays,
      notificationEnabled,
      notes: notes.trim(),
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    };
    
    const docRef = await db.collection('reminders').add(reminderData);
    
    console.log(`✅ Reminder created with ID: ${docRef.id}`);
    
    res.json({
      success: true,
      data: {
        id: docRef.id,
        ...reminderData,
        dueDate: new Date(dueDate)
      }
    });
    
  } catch (error) {
    console.error('Create reminder error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to create reminder',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Update reminder
meetnsplitApp.put('/reminders/:id', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    const reminderId = req.params.id;
    const updates = req.body;
    
    console.log(`📝 Updating reminder ${reminderId} for user: ${userId}`);
    
    // Get the reminder to verify ownership
    const reminderDoc = await db.collection('reminders').doc(reminderId).get();
    
    if (!reminderDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Reminder not found',
        error: 'REMINDER_NOT_FOUND'
      });
    }
    
    const reminder = reminderDoc.data();
    
    // Verify ownership
    if (reminder.userId !== userId) {
      return res.status(403).json({
        success: false,
        message: 'Access denied',
        error: 'FORBIDDEN'
      });
    }
    
    // Prepare update data
    const updateData = {
      ...updates,
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    };
    
    // Remove undefined values and handle date conversion
    Object.keys(updateData).forEach(key => {
      if (updateData[key] === undefined) {
        delete updateData[key];
      } else if (key === 'dueDate' && updateData[key]) {
        updateData[key] = admin.firestore.Timestamp.fromDate(new Date(updateData[key]));
      }
    });
    
    // Update the reminder
    await db.collection('reminders').doc(reminderId).update(updateData);
    
    console.log(`✅ Reminder ${reminderId} updated successfully`);
    
    res.json({
      success: true,
      message: 'Reminder updated successfully'
    });
    
  } catch (error) {
    console.error('Update reminder error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to update reminder',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

