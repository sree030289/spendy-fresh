// SETTLEMENTS APIs
// ========================

// Get group settlements
spendyApp.get('/settlements/group/:groupId', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.userId;
    const { groupId } = req.params;
    
    console.log(`💸 Getting settlements for group: ${groupId}, user: ${userId}`);
    
    // Get group to verify access
    const groupDoc = await db.collection('groups').doc(groupId).get();
    if (!groupDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Group not found',
        error: 'GROUP_NOT_FOUND'
      });
    }
    
    const groupData = groupDoc.data();
    const userIsMember = groupData.members && groupData.members.some(member => 
      typeof member === 'string' ? member === userId : member.userId === userId
    );
    
    if (!userIsMember) {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to view this group',
        error: 'UNAUTHORIZED'
      });
    }
    
    // Get settlements for this group
    const settlementsQuery = await db.collection('settlements')
      .where('groupId', '==', groupId)
      .orderBy('createdAt', 'desc')
      .get();
    
    let settlements = [];
    settlementsQuery.forEach(doc => {
      const data = doc.data();
      settlements.push({
        id: doc.id,
        ...data,
        createdAt: data.createdAt&&toDate ? data.createdAt.toDate() : data.createdAt
      });
    });
    
    console.log(`💸 Found ${settlements.length} settlements for group: ${groupId}`);
    
    res.json({
      success: true,
      data: settlements
    });
    
  } catch (error) {
    console.error('Get group settlements error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get group settlements',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Record settlement
spendyApp.post('/settlements', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.userId;
    const { fromUserId, toUserId, amount, groupId, note } = req.body;
    
    console.log(`💸 Recording settlement: ${fromUserId} -> ${toUserId}, amount: ${amount}, group: ${groupId}`);
    
    // Verify user is authorized (must be fromUserId or have access to group)
    if (fromUserId !== userId) {
      // Check if user has access to the group
      const groupDoc = await db.collection('groups').doc(groupId).get();
      if (!groupDoc.exists) {
        return res.status(404).json({
          success: false,
          message: 'Group not found',
          error: 'GROUP_NOT_FOUND'
        });
      }
      
      const groupData = groupDoc.data();
      const userIsMember = groupData.members && groupData.members.some(member => 
        typeof member === 'string' ? member === userId : member.userId === userId
      );
      
      if (!userIsMember) {
        return res.status(403).json({
          success: false,
          message: 'Not authorized to record settlement for this group',
          error: 'UNAUTHORIZED'
        });
      }
    }
    
    const settlementData = {
      fromUserId,
      toUserId,
      amount: parseFloat(amount),
      groupId,
      note: note || '',
      status: 'completed',
      createdAt: FieldValue.serverTimestamp(),
      recordedBy: userId
    };
    
    const docRef = await db.collection('settlements').add(settlementData);
    
    console.log(`💸 Settlement recorded with ID: ${docRef.id}`);
    
    res.json({
      success: true,
      data: { id: docRef.id, ...settlementData },
      message: 'Settlement recorded successfully'
    });
    
  } catch (error) {
    console.error('Record settlement error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to record settlement',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

