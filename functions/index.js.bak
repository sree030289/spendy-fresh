// Remove Friend with Notification
spendyApp.delete('/friends/:friendId', authenticateJWT, async (req, res) => {
  try {
    const { friendId } = req.params;
    const userId = req.user.id;
    const { isBlocked = false } = req.body;

    console.log('💔 Removing friend:', friendId, { isBlocked });

    // Find and delete friendship
    const friendshipsQuery = await db.collection('friendships')
      .where('user1Id', 'in', [userId, friendId])
      .where('user2Id', 'in', [userId, friendId])
      .where('status', '==', 'active')
      .get();

    if (friendshipsQuery.empty) {
      return res.status(404).json({
        success: false,
        message: 'Friendship not found'
      });
    }

    // Update friendship status
    const batch = db.batch();
    friendshipsQuery.docs.forEach(doc => {
      batch.update(doc.ref, {
        status: isBlocked ? 'blocked' : 'removed',
        removedBy: userId,
        removedAt: new Date()
      });
    });
    await batch.commit();

    // Get user data for notification
    const removerDoc = await db.collection('users').doc(userId).get();
    const removerData = removerDoc.data();

    const action = isBlocked ? 'blocked' : 'removed';
    const title = isBlocked ? '🚫 You were blocked' : '💔 Friendship ended';
    const message = isBlocked 
      ? `${removerData.fullName} has blocked you on Spendy.`
      : `${removerData.fullName} is no longer your friend on Spendy.`;

    // Send notification to removed friend
    await db.collection('appNotifications').add({
      userId: friendId,
      type: 'friend_removed',
      title,
      message,
      data: {
        friendId: userId,
        friendName: removerData.fullName,
        action,
        navigationType: 'friends'
      },
      isRead: false,
      createdAt: new Date()
    });

    res.json({
      success: true,
      message: `Friend ${action} successfully`
    });
  } catch (error) {
    console.error('❌ Remove friend error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to remove friend',
      error: error.message
    });
  }
});

// Send Group Notification
spendyApp.post('/groups/:groupId/notify', authenticateJWT, async (req, res) => {
  try {
    const { groupId } = req.params;
    const { type, message, data = {} } = req.body;
    const userId = req.user.id;

    console.log('📢 Sending group notification:', { groupId, type, message });

    // Get group data
    const groupDoc = await db.collection('groups').doc(groupId).get();
    if (!groupDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Group not found'
      });
    }

    const groupData = groupDoc.data();
    
    // Verify user is member of group
    const isMember = groupData.members.some(member => member.userId === userId);
    if (!isMember) {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to send notifications to this group'
      });
    }

    // Get sender data
    const senderDoc = await db.collection('users').doc(userId).get();
    const senderData = senderDoc.data();

    // Send notifications to all group members except sender
    const notificationPromises = groupData.members
      .filter(member => member.userId !== userId)
      .map(member => 
        db.collection('appNotifications').add({
          userId: member.userId,
          type,
          title: message.title || 'Group Update',
          message: message.body || `Update in ${groupData.name}`,
          data: {
            groupId,
            groupName: groupData.name,
            senderId: userId,
            senderName: senderData.fullName,
            ...data
          },
          isRead: false,
          createdAt: new Date()
        })
      );

    await Promise.all(notificationPromises);

    res.json({
      success: true,
      message: `Notifications sent to ${notificationPromises.length} group members`
    });
  } catch (error) {
    console.error('❌ Send group notification error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to send group notification',
      error: error.message
    });
  }
});

// Send Expense Notification
spendyApp.post('/expenses/:expenseId/notify', authenticateJWT, async (req, res) => {
  try {
    const { expenseId } = req.params;
    const { type, action } = req.body;
    const userId = req.user.id;

    console.log('💰 Sending expense notification:', { expenseId, type, action });

    // Get expense data
    const expenseDoc = await db.collection('expenses').doc(expenseId).get();
    if (!expenseDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Expense not found'
      });
    }

    const expenseData = expenseDoc.data();
    
    // Get group data
    const groupDoc = await db.collection('groups').doc(expenseData.groupId).get();
    if (!groupDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Group not found'
      });
    }

    const groupData = groupDoc.data();
    
    // Get user data
    const userDoc = await db.collection('users').doc(userId).get();
    const userData = userDoc.data();

    // Generate notification content based on type and action
    let title, message;
    switch (type) {
      case 'expense_added':
        title = '💰 New Expense Added';
        message = `${userData.fullName} added "${expenseData.description}" (${expenseData.currency}${expenseData.amount}) to "${groupData.name}"`;
        break;
      case 'expense_edited':
        title = '✏️ Expense Updated';
        message = `${userData.fullName} edited "${expenseData.description}" in "${groupData.name}"`;
        break;
      case 'expense_deleted':
        title = '🗑️ Expense Deleted';
        message = `${userData.fullName} deleted "${expenseData.description}" from "${groupData.name}"`;
        break;
      case 'expense_settled':
        title = '💸 Payment Settled';
        message = `${userData.fullName} marked a payment as settled in "${groupData.name}"`;
        break;
      default:
        title = 'Expense Update';
        message = `${userData.fullName} updated an expense in "${groupData.name}"`;
    }

    // Send notifications to all group members except the actor
    const notificationPromises = groupData.members
      .filter(member => member.userId !== userId)
      .map(member => 
        db.collection('appNotifications').add({
          userId: member.userId,
          type,
          title,
          message,
          data: {
            groupId: expenseData.groupId,
            groupName: groupData.name,
            expenseId,
            expenseDescription: expenseData.description,
            amount: expenseData.amount,
            currency: expenseData.currency,
            actionBy: userData.fullName,
            navigationType: 'expenseDetails',
            canUndo: action === 'delete'
          },
          isRead: false,
          createdAt: new Date(),
          expiresAt: action === 'delete' ? new Date(Date.now() + 30000) : null // 30 seconds for undo
        })
      );

    await Promise.all(notificationPromises);

    res.json({
      success: true,
      message: `Expense notifications sent to ${notificationPromises.length} group members`
    });
  } catch (error) {
    console.error('❌ Send expense notification error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to send expense notification',
      error: error.message
    });
  }
});

// Undo Expense Action
spendyApp.post('/expenses/:expenseId/undo', authenticateJWT, async (req, res) => {
  try {
    const { expenseId } = req.params;
    const { action } = req.body;
    const userId = req.user.id;

    console.log('↩️ Undoing expense action:', { expenseId, action });

    const expenseRef = db.collection('expenses').doc(expenseId);
    const expenseDoc = await expenseRef.get();

    if (!expenseDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Expense not found'
      });
    }

    const expenseData = expenseDoc.data();

    // Handle undo based on action type
    switch (action) {
      case 'undo_delete':
        // Restore deleted expense
        await expenseRef.update({
          isDeleted: false,
          deletedBy: null,
          deletedAt: null,
          restoredBy: userId,
          restoredAt: new Date()
        });
        break;
      
      default:
        return res.status(400).json({
          success: false,
          message: 'Unknown undo action'
        });
    }

    res.json({
      success: true,
      message: 'Expense action undone successfully'
    });
  } catch (error) {
    console.error('❌ Undo expense action error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to undo expense action',
      error: error.message
    });
  }
});

// Clean up expired notifications
spendyApp.delete('/notifications/cleanup', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    
    console.log('🧹 Cleaning up expired notifications for user:', userId);

    // Delete expired notifications
    const expiredQuery = await db.collection('appNotifications')
      .where('userId', '==', userId)
      .where('expiresAt', '<', new Date())
      .get();

    if (!expiredQuery.empty) {
      const batch = db.batch();
      expiredQuery.docs.forEach(doc => {
        batch.delete(doc.ref);
      });
      await batch.commit();
    }

    res.json({
      success: true,
      message: `Cleaned up ${expiredQuery.size} expired notifications`
    });
  } catch (error) {
    console.error('❌ Cleanup notifications error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to cleanup notifications',
      error: error.message
    });
  }
});

