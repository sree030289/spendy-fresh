// Get user reminders
spendyApp.get('/reminders', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    
    // Get query parameters
    const {
      status,
      category,
      startDate,
      endDate,
      page = 1,
      limit = 50,
      search
    } = req.query;
    
    console.log(`📋 Getting reminders for user: ${userId}`);
    
    // Build query
    let query = db.collection('reminders').where('userId', '==', userId);
    
    // Add filters
    if (status && status !== 'all') {
      query = query.where('status', '==', status);
    }
    
    if (category) {
      query = query.where('category', '==', category);
    }
    
    // Order by due date
    query = query.orderBy('dueDate', 'asc');
    
    // Execute query
    const snapshot = await query.get();
    
    let reminders = [];
    snapshot.forEach(doc => {
      const data = doc.data();
      reminders.push({
        id: doc.id,
        ...data,
        dueDate: data.dueDate&&toDate ? data.dueDate.toDate() : data.dueDate,
        createdAt: data.createdAt&&toDate ? data.createdAt.toDate() : data.createdAt,
        updatedAt: data.updatedAt&&toDate ? data.updatedAt.toDate() : data.updatedAt,
        paidDate: data.paidDate&&toDate ? data.paidDate.toDate() : data.paidDate
      });
    });
    
    // Apply text search filter
    if (search) {
      const searchLower = search.toLowerCase();
      reminders = reminders.filter(reminder => 
        reminder.title&&toLowerCase().includes(searchLower) ||
        reminder.description&&toLowerCase().includes(searchLower) ||
        reminder.category&&toLowerCase().includes(searchLower)
      );
    }
    
    // Apply date filters
    if (startDate) {
      const start = new Date(startDate);
      reminders = reminders.filter(reminder => new Date(reminder.dueDate) >= start);
    }
    
    if (endDate) {
      const end = new Date(endDate);
      reminders = reminders.filter(reminder => new Date(reminder.dueDate) <= end);
    }
    
    // Apply pagination
    const totalReminders = reminders.length;
    const offset = (parseInt(page) - 1) * parseInt(limit);
    const paginatedReminders = reminders.slice(offset, offset + parseInt(limit));
    
    console.log(`📋 Found ${totalReminders} reminders for user: ${userId}`);
    
    res.json({
      success: true,
      data: {
        data: paginatedReminders,
        pagination: {
          page: parseInt(page),
          limit: parseInt(limit),
          total: totalReminders,
          totalPages: Math.ceil(totalReminders / parseInt(limit))
        }
      }
    });
    
  } catch (error) {
    console.error('Get reminders error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get reminders',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Create reminder
spendyApp.post('/reminders', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
