    res.status(500).json({
      success: false,
      message: 'Failed to delete reminder',
      error: 'INTERNAL_SERVER_ERROR'
    });
  }
});

// Gmail OAuth callback route
spendyApp.get('/gmail/callback', async (req, res) => {
  try {
    const { code, state } = req.query;
    
    if (!code) {
      return res.status(400).send('Authorization code missing');
    }

    // The state parameter contains the userId
    const userId = state;
    
    console.log(`🔗 Gmail OAuth callback for user: ${userId}`);
    
    // Exchange code for access token using the same logic as /gmail/connect
    const tokenResponse = await fetch('https://oauth2.googleapis.com/token', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        client_id: '827143652568-4bc26tin0r22lsfb4oea9hoscvmk4tao.apps.googleusercontent.com',
        client_secret: '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',
        code: code,
        grant_type: 'authorization_code',
        redirect_uri: 'https://us-central1-spendy-develop.cloudfunctions.net/spendyApi/gmail/callback'
      })
    });
    
    if (!tokenResponse.ok) {
      throw new Error(`Token exchange failed: ${tokenResponse.statusText}`);
    }
    
    const tokens = await tokenResponse.json();
    
    // Get user info from Google
    const userInfoResponse = await fetch('https://www.googleapis.com/oauth2/v2/userinfo', {
      headers: {
        'Authorization': `Bearer ${tokens.access_token}`
      }
    });
    
    if (!userInfoResponse.ok) {
      throw new Error(`Failed to get user info: ${userInfoResponse.statusText}`);
    }
    
    const userInfo = await userInfoResponse.json();
    
    // Calculate token expiry
    const expiresAt = new Date(Date.now() + (tokens.expires_in * 1000));
    
    const connectionData = {
      userId,
      email: userInfo.email,
      accessToken: tokens.access_token,
      refreshToken: tokens.refresh_token || null,
      expiresAt,
      isConnected: true,
      autoSync: true,
      syncFrequency: 'daily',
      connectedAt: FieldValue.serverTimestamp(),
      updatedAt: FieldValue.serverTimestamp()
    };
    
    // Store the connection in Firestore
    await db.collection('gmailConnections').doc(userId).set(connectionData);
    
    console.log(`✅ Gmail connected successfully for user: ${userId}, email: ${userInfo.email}`);
    
    // Redirect to app with success and real email
    res.redirect(`com.spendy.app://oauth?success=true&email=${encodeURIComponent(userInfo.email)}`);
    
  } catch (error) {
    console.error('Gmail OAuth callback error:', error);
    res.redirect(`com.spendy.app://oauth?error=${encodeURIComponent(error.message)}`);
  }
});

// Export Spendy API as Firebase Function
exports.spendyApi = functions.https.onRequest(spendyApp);

// ===== COMPREHENSIVE NOTIFICATION API ENDPOINTS =====

// Get User Notifications
spendyApp.get('/notifications', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;
    const limit = parseInt(req.query.limit) || 50;
    const page = parseInt(req.query.page) || 1;
    const unreadOnly = req.query.unreadOnly === 'true';
    
    console.log('📱 Getting notifications for user:', userId, { limit, page, unreadOnly });

    let query = db.collection('appNotifications')
      .where('userId', '==', userId)
      .orderBy('createdAt', 'desc');

    if (unreadOnly) {
      query = query.where('isRead', '==', false);
    }

    const snapshot = await query.limit(limit).offset((page - 1) * limit).get();
    
    const notifications = [];
    snapshot.forEach(doc => {
      const data = doc.data();
      notifications.push({
        id: doc.id,
        ...convertFirestoreTimestamps(data)
      });
    });

    // Get unread count
    const unreadQuery = await db.collection('appNotifications')
      .where('userId', '==', userId)
      .where('isRead', '==', false)
      .get();

    res.json({
      success: true,
      data: {
        notifications,
        unreadCount: unreadQuery.size,
        totalCount: notifications.length,
        currentPage: page,
        hasMore: notifications.length === limit
      }
    });
  } catch (error) {
    console.error('❌ Get notifications error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to get notifications',
      error: error.message
    });
  }
});

// Mark Notification as Read
spendyApp.put('/notifications/:notificationId/read', authenticateJWT, async (req, res) => {
  try {
    const { notificationId } = req.params;
    const userId = req.user.id;

    console.log('📖 Marking notification as read:', notificationId);

    const notificationRef = db.collection('appNotifications').doc(notificationId);
    const notificationDoc = await notificationRef.get();

    if (!notificationDoc.exists) {
      return res.status(404).json({
        success: false,
        message: 'Notification not found'
      });
    }

    const notificationData = notificationDoc.data();
    if (notificationData.userId !== userId) {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to modify this notification'
      });
    }

    await notificationRef.update({
      isRead: true,
      readAt: new Date()
    });

    res.json({
      success: true,
      message: 'Notification marked as read'
    });
  } catch (error) {
    console.error('❌ Mark notification as read error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to mark notification as read',
      error: error.message
    });
  }
});

// Mark All Notifications as Read
spendyApp.put('/notifications/read-all', authenticateJWT, async (req, res) => {
  try {
    const userId = req.user.id;

    console.log('📖 Marking all notifications as read for user:', userId);

    const unreadNotifications = await db.collection('appNotifications')
      .where('userId', '==', userId)
      .where('isRead', '==', false)
      .get();

    const batch = db.batch();
    unreadNotifications.docs.forEach(doc => {
      batch.update(doc.ref, {
        isRead: true,
        readAt: new Date()
      });
    });

    await batch.commit();

    res.json({
      success: true,
      message: `Marked ${unreadNotifications.size} notifications as read`
    });
  } catch (error) {
    console.error('❌ Mark all notifications as read error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to mark all notifications as read',
      error: error.message
    });
  }
});

