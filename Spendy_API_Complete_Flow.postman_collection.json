        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Grocery Shopping\",\n  \"amount\": 80.00,\n  \"paidBy\": \"{{userId}}\",\n  \"groupId\": \"{{groupId}}\",\n  \"category\": \"groceries\",\n  \"description\": \"Weekly groceries\",\n  \"splitType\": \"custom\",\n  \"splitDetails\": [\n    {\n      \"userId\": \"{{userId}}\",\n      \"amount\": 30.00\n    },\n    {\n      \"userId\": \"{{friendId}}\",\n      \"amount\": 50.00\n    }\n  ]\n}"
