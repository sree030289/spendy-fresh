{
  "name": "spendy-fresh",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "EXPO_PUBLIC_BUILD_TYPE=dev expo start",
    "start:prod": "EXPO_PUBLIC_BUILD_TYPE=prod expo start",
    "start:no-dev": "EXPO_PUBLIC_BUILD_TYPE=prod expo start --no-dev",
    "env:local": "./scripts/env-switch.sh local",
    "env:development": "./scripts/env-switch.sh development",
    "env:production": "./scripts/env-switch.sh production",
    "env:status": "./scripts/env-status.sh",
    "env:verify": "node scripts/verify-environment.js",
    "db:cleanup": "./scripts/cleanup-firestore.sh",
    "android": "expo run:android",
    "android:dev": "EXPO_PUBLIC_BUILD_TYPE=dev expo run:android",
    "android:prod": "EXPO_PUBLIC_BUILD_TYPE=prod expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:dev": "EXPO_PUBLIC_BUILD_TYPE=dev expo run:ios",
    "ios:prod": "EXPO_PUBLIC_BUILD_TYPE=prod expo run:ios --configuration Release",
    "web": "expo start --web",
    "web:dev": "EXPO_PUBLIC_BUILD_TYPE=dev expo start --web",
    "test": "jest",
    "clean-logs": "node scripts/remove-debug-logs.js",
    "clean-logs:dry": "node scripts/remove-debug-logs.js --dry-run",
    "build:production": "./scripts/production-build.sh",
    "prebuild:production": "npm run clean-logs:dry",
    "test:api": "npx playwright test tests/e2e/specs/ --reporter=list",
    "test:api:all": "node scripts/test-api-runner.js",
    "test:api:all:bash": "./scripts/test-api-all.sh",
    "test:api:detailed": "node scripts/test-api-detailed-runner.js",
    "test:api:fresh": "npx playwright test tests/e2e/specs/ --reporter=list --workers=1",
    "test:api:connection": "npx playwright test tests/e2e/specs/00-connection-test.api.spec.js --reporter=list",
    "test:api:auth": "npx playwright test tests/e2e/specs/01-authentication.api.spec.js --reporter=list",
    "test:api:friends": "npx playwright test tests/e2e/specs/02-friend-management.api.spec.js --reporter=list",
    "test:api:groups": "npx playwright test tests/e2e/specs/03-group-management.api.spec.js --reporter=list",
    "test:api:expenses": "npx playwright test tests/e2e/specs/04-expense-management.api.spec.js --reporter=list",
    "test:api:settlements": "npx playwright test tests/e2e/specs/05-settlement-flow.api.spec.js --reporter=list",
    "test:api:notifications": "npx playwright test tests/e2e/specs/06-notification-system.api.spec.js --reporter=list",
    "test:api:integration": "npx playwright test tests/e2e/specs/07-complete-integration.api.spec.js --reporter=list",
    "test:api:verbose": "npx playwright test tests/e2e/specs/ --reporter=line --workers=1",
    "test:api:debug": "npx playwright test tests/e2e/specs/ --debug --workers=1",
    "deploy:dev": "firebase deploy --project dev --force",
    "deploy:prod": "firebase deploy --project prod --force",
    "deploy:functions:dev": "firebase deploy --only functions --project dev --force",
    "deploy:functions:prod": "firebase deploy --only functions --project prod --force",
    "test:api:dev": "EXPO_PUBLIC_BUILD_TYPE=dev npx playwright test tests/e2e/specs/ --reporter=list",
    "build:web": "npx expo export --platform web && node scripts/fix-web-icons.js",
    "build:web:dev": "EXPO_PUBLIC_BUILD_TYPE=dev npx expo export --platform web && node scripts/fix-web-icons-simple.js",
    "deploy:web": "npm run build:web && firebase deploy --only hosting",
    "deploy:web:dev": "npm run build:web:dev && firebase deploy --only hosting --project spendy-develop",
    "debug:icons": "node scripts/debug-icon-fonts.js",
    "migrate:icons": "node scripts/migrate-icons.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@react-navigation/stack": "^7.3.2",
    "canvas": "^3.2.0",
    "expo": "53.0.22",
    "expo-application": "~6.1.5",
    "expo-auth-session": "~6.2.1",
    "expo-background-fetch": "~13.1.6",
    "expo-blur": "^14.1.5",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.7",
    "expo-contacts": "~14.2.5",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-document-picker": "^13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-image-manipulator": "^14.0.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-local-authentication": "~16.0.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.4",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "^13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.8.1",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "libphonenumber-js": "^1.12.22",
    "lottie-react-native": "7.2.2",
    "lucide-react": "^0.263.1",
    "lucide-react-native": "^0.525.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "react-native": "0.79.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-image-resizer": "^1.4.5",
    "react-native-purchases": "^9.4.3",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-share": "^12.0.11",
    "react-native-svg": "15.11.2",
    "react-native-vision-camera": "^4.7.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@jest/globals": "^30.0.0-beta.3",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.73.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.0",
    "date-fns": "^2.29.0",
    "framer-motion": "^10.0.0",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.4.0",
    "react-hot-toast": "^2.4.0",
    "react-test-renderer": "^19.0.0",
    "recharts": "^2.5.0",
    "tailwindcss": "^3.2.0",
    "ts-jest": "^29.3.4",
    "typescript": "~5.8.3",
    "uuid": "^9.0.0",
    "vite": "^4.1.0"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
